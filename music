import numpy as np


def render_visualizer_frame(self, canvas, audio_chunk):
  # Generates 16 animated bar heights matching real-time audio amplitude
  canvas.delete("all")
  fft_data = np.abs(np.fft.rfft(audio_chunk))[:16]
  for i, val in enumerate(fft_data):
    bar_height = min(100, int(val * 10))
    canvas.create_rectangle(
        i * 20, 100 - bar_height, i * 20 + 15, 100, fill="#1DB954"
    )
