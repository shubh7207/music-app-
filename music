  # --- Artwork Extraction Helper ---

  def extract_album_art(self, file_path):
    """Extracts embedded ID3 album cover art from MP3 file binary"""
    try:
      tags = ID3(file_path)
      for key in tags.keys():
        if key.startswith("APIC"):  # APIC frame contains cover art
          image_bytes = tags[key].data
          raw_image = Image.open(io.BytesIO(image_bytes))
          raw_image = raw_image.resize((60, 60), Image.Resampling.LANCZOS)
          return ctk.CTkImage(
              light_image=raw_image, dark_image=raw_image, size=(60, 60)
          )
    except Exception:
      pass
    return self.default_cover

  # --- Playback Logic ---

  def play_song(self, index):
    self.current_index = index
    song_name = self.playlist[self.current_index]
    song_path = os.path.join(self.music_dir, song_name)

    # Extract MP3 duration
    try:
      audio = MP3(song_path)
      self.song_length = audio.info.length
    except Exception:
      self.song_length = 0

    # Extract Cover Artwork
    cover_art = self.extract_album_art(song_path)
    self.cover_label.configure(image=cover_art)

    self.seek_offset = 0
    self.seek_slider.set(0)
    self.time_total_label.configure(text=self.format_time(self.song_length))

    pygame.mixer.music.load(song_path)
    pygame.mixer.music.play()

    self.is_paused = False
    self.play_btn.configure(text="⏸")
    self.track_label.configure(text=song_name.rsplit(".", 1)[0])

  # --- Seekbar & Timer Helpers ---

  def format_time(self, seconds):
    mins = int(seconds // 60)
    secs = int(seconds % 60)
    return f"{mins:02d}:{secs:02d}"

  def update_progress_loop(self):
    if (
        pygame.mixer.music.get_busy()
        and not self.is_paused
        and self.song_length > 0
    ):
      current_pos = (
          pygame.mixer.music.get_pos() / 1000.0
      ) + self.seek_offset
      if current_pos <= self.song_length:
        progress = (current_pos / self.song_length) * 100
        self.seek_slider.set(progress)
        self.time_elapsed_label.configure(text=self.format_time(current_pos))

    self.after(200, self.update_progress_loop)

  def on_seek_release(self, value):
    if not self.playlist or self.song_length == 0:
      return

    target_time = (float(value) / 100.0) * self.song_length
    self.seek_offset = target_time
    pygame.mixer.music.play(start=target_time)

    if self.is_paused:
      pygame.mixer.music.pause()

    self.time_elapsed_label.configure(text=self.format_time(target_time))

  def toggle_play(self):
    if not self.playlist:
      return

    if pygame.mixer.music.get_busy() or self.is_paused:
      if self.is_paused:
        pygame.mixer.music.unpause()
        self.is_paused = False
        self.play_btn.configure(text="⏸")
      else:
        pygame.mixer.music.pause()
        self.is_paused = True
        self.play_btn.configure(text="▶")
    else:
      self.play_song(self.current_index)

  def next_song(self):
    if self.playlist:
      self.current_index = (self.current_index + 1) % len(self.playlist)
      self.play_song(self.current_index)

  def prev_song(self):
    if self.playlist:
      self.current_index = (self.current_index - 1) % len(self.playlist)
      self.play_song(self.current_index)

  def set_volume(self, val):
    pygame.mixer.music.set_volume(float(val))

  # --- Downloader & Storage ---

  def start_download(self):
    query = self.search_entry.get().strip()
    if not query:
      self.status_label.configure(
          text="Please enter a song name or link.", text_color="#FF5555"
      )
      return

    self.status_label.configure(
        text="Downloading song with cover art... Please wait.",
        text_color="#1DB954",
    )
    threading.Thread(
        target=self.download_audio, args=(query,), daemon=True
    ).start()

  def download_audio(self, query):
    ydl_opts = {
        "format": "bestaudio/best",
        "outtmpl": os.path.join(self.music_dir, "%(title)s.%(ext)s"),
        "default_search": "ytsearch",
        "writethumbnail": True,  # Download cover art thumbnail
        "postprocessors": [
            {
                "key": "FFmpegExtractAudio",
                "preferredcodec": "mp3",
                "preferredquality": "192",
            },
            {
                "key": "FFmpegMetadata",  # Embed title/artist metadata
            },
            {
                "key": "EmbedThumbnail",  # Embed downloaded thumbnail directly into ID3 tags
            },
        ],
        "quiet": True,
        "nocheckcertificate": True,
    }

    try:
      with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([query])

      self.status_label.configure(
          text="Downloaded with Cover Art! 🔒", text_color="#1DB954"
      )
      self.search_entry.delete(0, "end")
      self.after(500, self.refresh_playlist)

    except Exception as e:
      self.status_label.configure(
          text=f"Error downloading: {str(e)}", text_color="#FF5555"
      )

  def refresh_playlist(self):
    for widget in self.playlist_scrollable.winfo_children():
      widget.destroy()

    self.playlist = [
        f
        for f in os.listdir(self.music_dir)
        if f.endswith((".mp3", ".wav", ".ogg"))
    ]

    if not self.playlist:
      no_songs = ctk.CTkLabel(
          self.playlist_scrollable,
          text="No songs downloaded yet.",
          text_color="#B3B3B3",
      )
      no_songs.pack(pady=20)
      return

    for idx, song in enumerate(self.playlist):
      btn = ctk.CTkButton(
          self.playlist_scrollable,
          text=f"🎵  {song.rsplit('.', 1)[0]}",
          anchor="w",
          fg_color="#1E1E1E",
          hover_color="#282828",
          text_color="#FFFFFF",
          height=40,
          command=lambda i=idx: self.play_song(i),
      )
      btn.pack(fill="x", pady=2, padx=5)

  def open_app_folder(self):
    if os.name == "nt":
      os.startfile(self.music_dir)
    elif os.name == "posix":
      os.system(f'open "{self.music_dir}"')


