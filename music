import customtkinter as ctk

class SpotifyApp(ctk.CTk):
    def __init__(self):
        super().__init__()

        # Register global keyboard shortcuts
        self.bind_all("<space>", self.on_space_pressed)
        self.bind_all("<Right>", lambda event: self.next_track())
        self.bind_all("<Left>", lambda event: self.prev_track())
        self.bind_all("<Up>", lambda event: self.adjust_volume(0.05))
        self.bind_all("<Down>", lambda event: self.adjust_volume(-0.05))

    def on_space_pressed(self, event):
        """Toggles Play/Pause unless the user is actively typing in an entry field."""
        focused_widget = self.focus_get()

        if isinstance(focused_widget, (ctk.CTkEntry, ctk.CTkOptionMenu)) or "entry" in str(type(focused_widget)).lower():
            return

        self.toggle_play_pause()
        return "break"

    def toggle_play_pause(self):
        """Play/Pause toggle logic."""
        if hasattr(self, "is_playing") and self.is_playing:
            self.is_playing = False
            self.play_pause_btn.configure(text="▶")
            self.status_label.configure(text="Paused ⏸️", text_color="#E5C07B")
        else:
            self.is_playing = True
            self.play_pause_btn.configure(text="⏸")
            self.status_label.configure(text="Playing ▶️", text_color="#1DB954")

    def next_track(self):
        """Skip to next track logic."""
        self.status_label.configure(text="Skipped to Next Track ⏭️", text_color="#1DB954")

    def prev_track(self):
        """Previous track logic."""
        self.status_label.configure(text="Skipped to Previous Track ⏮️", text_color="#1DB954")

    def adjust_volume(self, delta):
        """Adjust volume up or down by delta (e.g. +/- 0.05)."""
        if hasattr(self, "current_volume"):
            new_vol = max(0.0, min(1.0, self.current_volume + delta))
            self.current_volume = new_vol
            if hasattr(self, "volume_slider"):
                self.volume_slider.set(new_vol)
            self.status_label.configure(text=f"Volume: {int(new_vol * 100)}%", text_color="#1DB954")
import requests


def fetch_lyrics(self, artist, title):
  try:
    url = f"https://lrclib.net/api/get?artist_name={artist}&track_name={title}"
    response = requests.get(url, timeout=3).json()
    synced_lyrics = response.get("syncedLyrics", "No synced lyrics found.")
    return synced_lyrics
  except Exception:
    return "Lyrics unavailable."
