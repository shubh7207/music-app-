def load_lyrics_for_track(self, artist, title):
      """Fetches synced lyrics from LrcLib API and parses them into timestamps."""
      self.parsed_lyrics = []
      self.lyric_labels = []
      self.current_lyric_index = -1

      # Clear existing lyric widgets
      for widget in self.lyrics_scroll.winfo_children():
        widget.destroy()

      try:
        url = (
            f"https://lrclib.net/api/get?artist_name={artist}&track_name={title}"
        )
        response = requests.get(url, timeout=4)

        if response.status_code == 200:
          data = response.json()
          synced_lrc = data.get("syncedLyrics")

          if synced_lrc:
            self.parse_lrc_format(synced_lrc)
            self.render_lyrics_ui()
            return

        # Fallback if no synced lyrics exist
        self._display_lyrics_placeholder("No synchronized lyrics found.")

      except Exception as e:
        self._display_lyrics_placeholder("Could not connect to lyrics server.")

    def parse_lrc_format(self, lrc_string):
      """Converts raw .lrc string into a sorted list of (seconds, text) tuples."""
      pattern = re.compile(r"\[(\d{2}):(\d{2}\.\d{2})\](.*)")

      for line in lrc_string.splitlines():
        match = pattern.match(line.strip())
        if match:
          minutes = int(match.group(1))
          seconds = float(match.group(2))
          text = match.group(3).strip()

          total_seconds = minutes * 60 + seconds
          if text:  # Ignore empty timestamp lines
            self.parsed_lyrics.append((total_seconds, text))

      # Sort chronologically by timestamp
      self.parsed_lyrics.sort(key=lambda x: x[0])

    def render_lyrics_ui(self):
      """Renders lyric lines as CustomTkinter labels."""
      for _, text in self.parsed_lyrics:
        lbl = ctk.CTkLabel(
            self.lyrics_scroll,
            text=text,
            font=("Arial", 16, "bold"),
            text_color="#535353",  # Inactive lines are dimmed
            anchor="center",
            wraplength=500,
        )
        lbl.pack(fill="x", pady=8)
        self.lyric_labels.append(lbl)

    def _display_lyrics_placeholder(self, text):
      lbl = ctk.CTkLabel(
          self.lyrics_scroll,
          text=text,
          font=("Arial", 14),
          text_color="#A7A7A7",
      )
      lbl.pack(pady=40)
def update_synced_lyrics(self, current_sec):
      """Highlights current active line and scrolls view smoothly."""
      if not self.parsed_lyrics or not self.lyric_labels:
        return

      # Find active lyric index matching current playback position
      active_idx = -1
      for i, (timestamp, _) in enumerate(self.parsed_lyrics):
        if current_sec >= timestamp:
          active_idx = i
        else:
          break

      # If lyric index changed, update UI highlighting and auto-scroll
      if active_idx != self.current_lyric_index and active_idx != -1:
        # Dim previous line
        if self.current_lyric_index != -1:
          self.lyric_labels[self.current_lyric_index].configure(
              text_color="#535353", font=("Arial", 16, "bold")
          )

        # Highlight current line in Spotify green/white
        self.lyric_labels[active_idx].configure(
            text_color="#1DB954", font=("Arial", 20, "bold")
        )
        self.current_lyric_index = active_idx

        # Calculate scroll position ratio (0.0 to 1.0)
        total_lines = len(self.lyric_labels)
        scroll_ratio = active_idx / float(total_lines)

        # Smoothly scroll container to target line
        self.lyrics_scroll._parent_canvas.yview_moveto(
            max(0.0, scroll_ratio - 0.2)
        )
